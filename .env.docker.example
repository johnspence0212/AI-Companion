# Copy to .env in the repository root, then run:
#   docker compose up --build
#
# Generate secrets, e.g.:
#   openssl rand -base64 48

POSTGRES_PASSWORD=change_me_strong_postgres_password
SEED_ADMIN_PASSWORD=ChangeMe_Admin_Pass123!

WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

SEED_ADMIN_EMAIL=admin@enterprisestarter.local

# SameAsRequest (local HTTP compose) or Always (TLS at edge with X-Forwarded-Proto=https)
AUTH_COOKIE_SECURE_POLICY=SameAsRequest

# Optional OpenTelemetry OTLP exporter (empty = disabled)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=enterprise-starter-api
